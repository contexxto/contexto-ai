# Copia este archivo como .env y completa los valores reales
# NUNCA subas el .env real al repositorio (está en .gitignore)
#
# ── SI PIERDES LA MÁQUINA: de dónde salen los valores ─────────────────────────
# Casi todos están en Render → contexto-ai-oregon → Environment (el ojo revela cada
# valor). Ese panel es, de hecho, la fuente de verdad de producción: `render.yaml` NO
# lo es — hay variables que solo existen en el panel. Ver la cabecera de render.yaml.
# Lo que NO está ahí y hay que sacar de su origen:
#   · VITE_* del frontend  → ver frontend/.env.example (Supabase → Settings → API Keys)
#   · valores de pool      → los de abajo; son de desarrollo, no viven en producción
# Y una advertencia: en producción DATABASE_URL_OVERRIDE apunta al puerto 5432. Si
# copias ese valor tal cual a tu máquina, compartes el techo de 15 conexiones con el
# servicio en vivo. Lee la sección de pools más abajo antes de dejarlo así.

# ── Base de datos (dev local con Docker/PostGIS) ──
POSTGRES_DB=contexto_v2
POSTGRES_USER=contexto_admin
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# En producción (Render + Supabase): URL completa del Session Pooler.
# Tiene precedencia sobre los POSTGRES_* de arriba.
# Formato: postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-...pooler.supabase.com:5432/postgres
DATABASE_URL_OVERRIDE=

# ── Conexiones a Postgres — LEE ESTO SI APUNTAS A LA SUPABASE COMPARTIDA ──────
# El Session Pooler de Supabase (puerto 5432) corta en 15 CLIENTES POR PROYECTO, y
# desarrollo y producción comparten proyecto. O sea: tu backend local le quita
# conexiones a producción. Y pasarse NO falla ruidosamente — el checkpointer de
# LangGraph no logra abrir su pool, el grafo arranca con MemorySaver y la app
# responde 200 en TODO pero sin historial: conversaciones sin título que no abren.
# Corrió así 1h26m sin que nadie lo notara. Ver docs/INCIDENTE_2026-08-18_Pools.md.
#
# Contra ese techo tiran DOS pools: SQLAlchemy (DB_POOL_SIZE + DB_MAX_OVERFLOW) y el
# checkpointer (CHECKPOINTER_POOL_SIZE). Los defaults del código (4+2+6 = 12) están
# pensados para PRODUCCIÓN. En local, con estos valores, bajas a 5 y dejas respirar
# al otro. Aun así 5 + 12 = 17 > 15: funciona porque los pools son perezosos (solo
# abren lo que se usa), no porque quepa. Si te sobran los 503 en el arranque, el
# arreglo NO es subir estos números — es apuntar al Transaction Pooler (puerto 6543),
# que admite miles de clientes. Ya está soportado: cambia el 5432 por 6543 en
# DATABASE_URL_OVERRIDE y app/database.py aplica solo la configuración correcta
# (NullPool + nombres únicos de prepared statement). Con el 6543 estas tres variables
# dejan de tener efecto, porque no hay pool del lado cliente que dimensionar.
#
# Si usas la base local de Docker (POSTGRES_* de arriba, sin DATABASE_URL_OVERRIDE),
# nada de esto aplica: no compartes techo con nadie y puedes borrar estas tres.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=1
CHECKPOINTER_POOL_SIZE=2

# ── LLM — Anthropic Claude ──
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=claude-sonnet-4-5-20250929

# ── Google Maps Places — enriquecimiento del entorno (en vivo) ──
# Si está vacía, el sistema NO se rompe: cae automáticamente a OpenStreetMap. O sea que
# su ausencia se nota en la CALIDAD de los datos, no en un error — revísala si el entorno
# de una ficha se ve pobre sin motivo aparente. Ver app/config.py.
GOOGLE_MAPS_API_KEY=

# ── SSL ──
# false SOLO en redes corporativas con SSL inspection (dev local).
# En producción debe ser SIEMPRE "true".
SSL_VERIFY=true

# ── Seguridad (Fase 3) ──
# Orígenes permitidos para CORS, separados por comas.
# En producción: el dominio de Vercel. En dev: localhost.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Clave que el frontend envía en el header X-API-Key.
# Vacía en dev (el check se desactiva). En producción: clave fuerte.
# OJO: desde el 2026-08-24 también protege POST /api/v1/assets/ (alta del catastro).
# Los scripts de carga masiva ya la enviaban; ahora además se valida.
# Y si está vacía EN PRODUCCIÓN, las rutas protegidas responden 503 en vez de abrirse:
# una variable ausente no puede desproteger el catastro en silencio.
API_KEY=

# ── A qué API apuntan los evals y los scripts (NO lo lee el backend) ─────────
# OVERRIDE OPCIONAL: va COMENTADA a propósito. Descoméntala solo para apuntar a otra
# API; si no, cada consumidor cae a https://contexto-ai-oregon.onrender.com.
# Va comentada y no vacía porque declararla vacía la convierte en un valor: quien copie
# este archivo a .env se lleva CONTEXTO_API_URL="" al entorno, y una cadena vacía puede
# ganarle al respaldo según cómo se resuelva. Comentada, la variable sencillamente no
# existe. (Los consumidores igual toleran la cadena vacía — ver tests/
# test_resolucion_api_url.py — pero eso es la red de abajo, no la de arriba.)
#
# La leen evals/run_evals.py y los scripts generar_qrs.py / hidratar_activos.py.
# Precedencia: el flag --api gana sobre la variable de shell, que gana sobre este
# archivo, que gana sobre el respaldo del código.
#   $env:CONTEXTO_API_URL="http://localhost:8000"; python scripts/generar_qrs.py
#
# Existe porque el servicio de Render ya se renombró una vez (contexto-ai →
# contexto-ai-oregon) y los defaults clavados en el código quedaron apuntando a un 503
# sin que nadie lo notara. El arreglo de fondo es el dominio propio (api.contexxto.com);
# mientras tanto, esto permite corregir un renombrado sin tocar código.
#CONTEXTO_API_URL=

# Entorno de ejecución: "production" | "dev". Vacío = se infiere.
# La inferencia usa RENDER, que Render inyecta solo en sus servicios, así que en el
# despliegue real no hay que configurar nada para quedar del lado seguro. Declararlo
# a mano solo para forzar el comportamiento (p. ej. probar el modo producción en local).
ENVIRONMENT=

# ── Avisos de operación ──
# A dónde escribir cuando una tarea de mantenimiento falla (hoy: el refresco semanal
# de pois_propios). Separar varios con comas. Vacío = el fallo solo sale por consola,
# que es como el release roto de Overture pasó semanas sin que nadie lo notara.
# Requiere RESEND_API_KEY para poder enviar.
ALERTA_OPS_EMAIL=

# ── Overture ──
# El release se DESCUBRE solo (el más reciente que publique el bucket). Overture borra
# los viejos, así que fijar uno es una bomba de tiempo: el que estaba escrito a mano
# había dejado de existir. Rellenar esto solo para clavar un release concreto a
# propósito — por ejemplo, para reproducir una corrida pasada.
OVERTURE_RELEASE=
